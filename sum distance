class Solution {
public:
    vector<long long> distance(vector<int>& nums) {
        vector<long long >ans;
        for(int i=0;i<nums.size();i++){
            long long sum=0;
            for(int j=0;j<nums.size();j++){
                if((nums[i]==nums[j]) && (i!=j)){
                    sum+=abs(i-j);
                }
            }
            if(sum==0){
                ans.push_back(0);
            }
            else{
                ans.push_back(sum);
            }
        }
        return ans;
        
    }
};
